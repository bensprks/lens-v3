# Monad deployment (script/DeployMonad.s.sol): proxy admins of LensCreate2 and of the rules, and the wrapped native
# token (defaults to WMON on Monad)
LENS_CREATE_2_PROXY_ADMIN=
RULES_PROXY_OWNER=
WRAPPED_NATIVE_TOKEN=

# Primitives owner
PRIMITIVES_OWNER=

